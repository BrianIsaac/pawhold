# pawhold's environment. Copy to .env.local for `pnpm dev`; never commit a
# filled copy. On Render these come from render.yaml and the dashboard.

# Postgres. Locally: the compose.yml database.
DATABASE_URL=postgres://pawhold:pawhold@127.0.0.1:54329/pawhold

# Signs judge-mode session cookies; at least 32 characters. Render generates
# one. Locally: `openssl rand -base64 32`.
SESSION_SECRET=

# PayPal, sandbox only. From the developer dashboard: the REST app `pawhold`.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# The id PayPal gives the webhook subscription to this listener's URL.
PAYPAL_WEBHOOK_ID=

# Accept the webhook simulator's mock events (signed with WEBHOOK_ID). For a
# listener under test only; "false" on the judged deployment.
PAYPAL_ACCEPT_MOCK_WEBHOOKS=false

# The GB sandbox personal account a judge logs in to PayPal with: shown on the
# owner's page in judge mode, and published in the README's testing
# instructions. Sandbox values only; without them the page points to the README.
PAYPAL_SANDBOX_BUYER_EMAIL=
PAYPAL_SANDBOX_BUYER_PASSWORD=

# The estimate agent's model (OpenAI, gpt-6.1-sol, D7). Server-side only.
# Without it every draft is an empty estimate the vet fills by hand.
OPENAI_API_KEY=

# The most times one practice (a judge's session has its own) may ask the
# model in an hour (D8); "off" lifts the cap. Default 40.
AGENT_DRAFTS_PER_HOUR=40

# Answer every draft from recorded answers instead of the model: a directory
# of `<hash>.json` files (`evals/recorded/`), or several joined by ":". No
# provider is asked. `pnpm test:browser` sets it; leave it unset to use the
# model above.
# AGENT_RECORDED_DIR=evals/recorded

# The practice's day is drawn on Bryntum's Scheduler (its trial), with the
# plain timeline under it whenever the Scheduler does not draw. "plain" keeps
# the day on the plain timeline and never loads the Scheduler. Leave unset
# for the board.
PAWHOLD_DAY_BOARD=
