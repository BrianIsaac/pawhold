{
  "name": "pawhold",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest --project unit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "cron:hourly": "tsx scripts/cron-hourly.ts",
    "paypal:smoke-order": "tsx scripts/sandbox-order-smoke.ts",
    "probes": "tsx probes/run.ts",
    "eval": "tsx evals/run.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "next": "16.4.0",
    "openai": "7.32.0",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tsx": "^4.23.15",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/node": "22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "4.10.2",
    "playwright": "1.64.0",
    "prettier": "^3.9.10",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
