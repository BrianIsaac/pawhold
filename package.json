{
  "name": "pawhold",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:browser": "tsx tests/browser/run.ts",
    "test:live": "playwright test --config playwright.live.config.ts",
    "live:await-deploy": "tsx tests/live/await-deploy.ts",
    "test:watch": "vitest --project unit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "cron:hourly": "tsx scripts/cron-hourly.ts",
    "paypal:smoke-order": "tsx scripts/sandbox-order-smoke.ts",
    "probes": "tsx probes/run.ts",
    "eval": "tsx evals/run.ts"
  },
  "//@bryntum/scheduler": "Bryntum's Scheduler on its trial (owner's decision D5 (b)), installed 13 October 2026. The trial runs out on 12 November 2026 by the licence's 30 days and on 27 November 2026 by the download page's 45; the package itself counts 45 days in each browser from that browser's first sight of the board. The day page falls back to the plain timeline when the Scheduler fails or shows its expiry. A licensed package is one line: change the alias below.",
  "dependencies": {
    "@bryntum/scheduler": "npm:@bryntum/scheduler-trial@7.3.7",
    "@bryntum/scheduler-react": "7.3.7",
    "@paypal/paypal-js": "11.2.2",
    "drizzle-orm": "0.45.4",
    "next": "16.4.0",
    "openai": "7.32.0",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tsx": "^4.23.15",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@types/node": "22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "4.10.2",
    "playwright": "1.64.0",
    "prettier": "^3.9.10",
    "typescript": "6.0.3",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  }
}
